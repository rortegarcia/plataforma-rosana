{
  "name": "plataforma-rosana",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-netlify",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "CONTACT_EMAIL": "rortegarcia@gmail.com",
    "RESEND_FROM": "Plataforma Português <onboarding@resend.dev>",
    "PAYPAL_URL": "https://paypal.me/rosanaortega/30EUR",
    "OWNER_EMAIL": "rortegarcia@gmail.com",
    "ACCESS_TEAM_DOMAIN": "https://raspy-art-28f2.cloudflareaccess.com",
    "ACCESS_AUD": "81a39e027b5611ec52047516472b222f4735b0e46be0629f616f61ed7106832d"
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "inscripciones-y-pagos",
      "database_id": "0f243f16-02b4-430b-a594-e129029c24e4"
    }
  ],
  "keep_vars": true
}
